AIEAS_DB_PATH=
AIEAS_UPLOAD_DIR=
AIEAS_PUBLIC_BASE_URL=
AIEAS_LLM_BASE_URL=
# OpenAI-compatible model ID (e.g. aieas-default or solar-pro4); must be non-empty.
AIEAS_MODEL=aieas-default
# Optional ontology AI request concurrency (default 2, maximum 16; development recommendation: 8).
# AIEAS_ONTOLOGY_CONCURRENCY=8
# Optional deployment declaration: solar or local-only. Empty uses the fixed model-prefix mapping.
AIEAS_AI_PROVIDER=
AIEAS_LLM_API_KEY=
AIEAS_REASONING_EFFORT=xhigh
# Keep both values identical when building for a path-prefixed proxy; leave both empty for local root-path development.
AIEAS_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
PORT=3000
HOSTNAME=localhost
# Secure default. Use `local` only in an isolated developer environment; it bypasses login.
AIEAS_AUTH_MODE=proxy
# Optional server-only JSON map: authenticated login to one of Admin, 평가팀, PO, 기획팀.
# Unmapped authenticated accounts are assigned the PoC default role 평가팀.
# AIEAS_ROLE_MAP={"<login>":"PO"}
